[Unit]
Description=ESP32-CAM relay server
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/esp32cam-oracle/server
ExecStart=/home/ubuntu/esp32cam-oracle/server/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
